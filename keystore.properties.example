# Release signing credentials — TEMPLATE.
#
# 1) Copy this file to:  keystore.properties   (same folder, project root)
# 2) Fill in the real values below.
# 3) keystore.properties and *.jks are gitignored — never commit them.
#
# storeFile is resolved relative to the app/ module directory.
# Example below assumes the keystore lives in a sibling "keys" folder:
#   VisitorsApp/
#     app/
#     keys/visitorsapp-release.jks   ->  storeFile=../keys/visitorsapp-release.jks

storeFile=../keys/visitorsapp-release.jks
storePassword=CHANGE_ME
keyAlias=visitorsapp
keyPassword=CHANGE_ME
